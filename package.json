{
  "name": "hookrelay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliable webhook delivery service with pluggable Kafka / AWS SQS transports, Redis-backed idempotency and retry scheduling.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx src/main.ts api",
    "dev:worker": "tsx src/main.ts worker",
    "dev:sink": "tsx src/services/sink.ts",
    "demo": "tsx scripts/demo.ts",
    "provision": "tsx scripts/provision.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.15.0"
}
